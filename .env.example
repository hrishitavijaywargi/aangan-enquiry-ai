# ─────────────────────────────────────────────────────────────
# Aangan Studio — Enquiry AI. Copy to .env.local and fill in.
# EVERYTHING IS OPTIONAL: with no values the app runs in demo mode
# (mock AI, simulated calls, email saved to data/outbox as .eml).
# Secrets are read server-side only and never sent to the browser.
# ─────────────────────────────────────────────────────────────

# --- AI (optional) ---------------------------------------------
# AI_PROVIDER=mock | anthropic   (default: mock)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Model used for field extraction + call summaries (default claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# --- Email handoff (optional) ----------------------------------
# If SMTP_HOST is empty, handoffs are saved locally and NOT sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Aangan Studio Enquiries <enquiries@example.com>"
HANDOFF_EMAIL_TO=designers@example.com
ESCALATION_EMAIL_TO=studio-head@example.com

# --- Telephony (optional, future) ------------------------------
# TELEPHONY_PROVIDER=demo | vaani | twilio   (default: demo)
TELEPHONY_PROVIDER=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Vaani Voice (optional, real phone calls) ------------------
# TELEPHONY_PROVIDER=vaani, then run `npm run vaani` and paste the public
# wss URL into Vaani: Agent → Brain → LLM → "Bring your Own LLM (BYOL)".
# Use the SAME long random token here and in Vaani's "Auth Token" field.
VAANI_BYOL_TOKEN=
VAANI_BYOL_PORT=8090

# --- Database (deployment) --------------------------------------
# Leave empty for the local SQLite file. Set to your Supabase
# "Transaction pooler" connection string for Vercel / shared data:
# postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Optional integrations (all OFF until set) ------------------
# Resend email (preferred over SMTP on Vercel). EMAIL_FROM must be on a domain you verified in Resend.
RESEND_API_KEY=
# Telegram instant alerts for urgent cases (complaints / missed follow-ups)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# HubSpot CRM: contact + deal for each qualified lead (private app token)
HUBSPOT_ACCESS_TOKEN=
# Calendly booking link included in designer handoffs
CALENDLY_URL=
# Set to true to also run integrations for demo/seeded calls (default: live calls only)
INTEGRATIONS_INCLUDE_DEMO=false
